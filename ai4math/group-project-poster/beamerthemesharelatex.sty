%
%==============================================================================
% Section and subsection re-definitions

\renewcommand{\section}[1]{
\par\vskip1cm%
%
     \begin{flushleft}
     \begin{tikzpicture}[remember picture,overlay]
       \shade [inner color=color2,outer color=white] (0,0) rectangle (\columnwidth,0.3cm);
     \end{tikzpicture}
     \end{flushleft}
%
     \begin{center}
%     \vskip1cm
     {\color{colorsec} {\textbf{\large #1}}}
     {\parskip0pt\par}
     \end{center}
%
     \begin{flushleft}
     \vskip-1.6cm
     \begin{tikzpicture}[remember picture,overlay]
       \shade [inner color=color2,outer color=white] (0,0) rectangle (\columnwidth,0.3cm);
     \end{tikzpicture}
     \end{flushleft}
%
  {\parskip0pt\par}
  \justifying
}

%%%
\renewcommand{\subsection}[1]{
\par\vskip0.5in%
     \begin{flushleft}
     \vskip0.8cm
     {\color{colorsub} {\textsc{\large #1}}}
     {\parskip0pt\par}
     \end{flushleft}
%
  \justifying
}

