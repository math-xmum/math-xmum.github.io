  \definecolor{color0}  {RGB}{0,0,0} %%% text color
  \definecolor{color1}  {RGB}{0,0,128} %%% title and subsection color
  \definecolor{color2}  {RGB}{13, 96, 155} %%% section color
  \definecolor{color3}  {RGB}{255,255,255} %%% background color
\definecolor{colorsec}  {RGB}{0, 0, 50} %%% background color
\definecolor{colorsub}  {RGB}{40, 116, 166} %%% background color



